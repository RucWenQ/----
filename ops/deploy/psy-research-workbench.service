[Unit]
Description=Psychology research workbench
After=network.target

[Service]
Type=simple
User=psy-tutorial
WorkingDirectory=/var/www/psy-tutorial/current
Environment=NODE_ENV=production
Environment=RESEARCH_PORT=4174
EnvironmentFile=-/etc/psy-research-workbench.env
ExecStart=/usr/bin/node /var/www/psy-tutorial/current/app/server/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
